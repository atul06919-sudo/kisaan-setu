generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum Role { FARMER PROCUREMENT_OPERATOR ADMIN }
enum ProcurementStatus { REQUESTED ARRIVED_AT_CENTRE QUALITY_CHECK WEIGHED APPROVED PAYMENT_PROCESSING PAID REJECTED }
enumm QualityStatus { PASS FAIL }

model User { id Int @id @default(autoincrement()); name String; mobile String @unique; password String; role Role; farmer Farmer?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Farmer { id Int @id @default(autoincrement()); farmerId String @unique; village String; district String; state String @default("Bihar"); landArea Float @default(0); userId Int @unique; user User @relation(fields:[userId], references:[id]); lands Land[]; crops FarmerCrop[]; procurements ProcurementRequest[]; payments Payment[]; notifications Notification[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Land { id Int @id @default(autoincrement()); surveyNumber String; area Float; village String; district String; ownershipType String; farmerId Int; farmer Farmer @relation(fields:[farmerId], references:[id], onDelete:Cascade); createdAt DateTime @default(now()) }
model Crop { id Int @id @default(autoincrement()); name String @unique; farmerCrops FarmerCrop[]; mspRates MSPRate[] }
model FarmerCrop { id Int @id @default(autoincrement()); acreage Float; estimatedQuantity Float; season String; sowingDate DateTime?; harvestDate DateTime?; farmerId Int; cropId Int; farmer Farmer @relation(fields:[farmerId], references:[id], onDelete:Cascade); crop Crop @relation(fields:[cropId], references:[id]); createdAt DateTime @default(now()) }
model MSPRate { id Int @id @default(autoincrement()); cropId Int; season String; rate Float; effectiveDate DateTime; crop Crop @relation(fields:[cropId], references:[id]); createdAt DateTime @default(now()); @@unique([cropId, season]) }
model ProcurementCentre { id Int @id @default(autoincrement()); centreId String @unique; name String; district String; state String; village String; address String; latitude Float; longitude Float; capacity Float; active Boolean @default(true); procurements ProcurementRequest[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model ProcurementRequest { id Int @id @default(autoincrement()); requestNumber String @unique; farmerId Int; cropId Int; centreId Int; quantity Float; preferredDate DateTime; status ProcurementStatus @default(REQUESTED); amount Float @default(0); farmer Farmer @relation(fields:[farmerId], references:[id]); crop Crop @relation(fields:[cropId], references:[id]); centre ProcurementCentre @relation(fields:[centreId], references:[id]); quality CropQuality?; weight Weight?; payment Payment?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model CropQuality { id Int @id @default(autoincrement()); moisture Float; qualityGrade String; qualityStatus QualityStatus; remarks String?; procurementId Int @unique; procurement ProcurementRequest @relation(fields:[procurementId], references:[id], onDelete:Cascade); createdAt DateTime @default(now()) }
model Weight { id Int @id @default(autoincrement()); grossWeight Float; tareWeight Float; netWeight Float; procurementId Int @unique; procurement ProcurementRequest @relation(fields:[procurementId], references:[id], onDelete:Cascade); createdAt DateTime @default(now()) }
model Payment { id Int @id @default(autoincrement()); transactionRef String @unique; amount Float; status String @default("PAYMENT_PROCESSING"); farmerId Int; procurementId Int @unique; farmer Farmer @relation(fields:[farmerId], references:[id]); procurement ProcurementRequest @relation(fields:[procurementId], references:[id]); paidAt DateTime?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Notification { id Int @id @default(autoincrement()); title String; message String; read Boolean @default(false); farmerId Int; farmer Farmer @relation(fields:[farmerId], references:[id], onDelete:Cascade); createdAt DateTime @default(now()) }
